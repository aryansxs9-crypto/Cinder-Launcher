{
  "name": "cinder-client",
  "productName": "Cinder Client",
  "version": "1.0.2",
  "description": "Next-Gen Minecraft Performance Launcher",
  "author": "aryansxs9",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.9",
    "minecraft-launcher-core": "^3.2.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cinder.launcher",
    "productName": "Cinder Client",
    "publish": [
      {
        "provider": "github",
        "owner": "aryansxs9-crypto",
        "repo": "Cinder-Launcher"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "logo (1).ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cinder Client"
    }
  }
}
