{
  "name": "ember-launcher",
  "version": "1.0.0",
  "description": "Ember Launcher desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "minecraft-launcher-core": "^3.2.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ember.launcher",
    "productName": "Ember Launcher",
    "win": {
      "target": "nsis"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js"
    ]
  }
}
